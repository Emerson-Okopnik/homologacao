# Usado explicitamente: docker compose --env-file .env.production -f compose.production.yaml ...
# API e web devem ser construídos a partir do mesmo commit e ter a mesma tag de release.
APP_IMAGE=homologa-solar/api:RELEASE_ID
WEB_IMAGE=homologa-solar/web:RELEASE_ID
DB_DATABASE=homologa
DB_USERNAME=homologa_app
