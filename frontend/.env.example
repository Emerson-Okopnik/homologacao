# Copie para .env.local para configurar o Vite executado fora do Docker.
# Vazio mantém /api e /sanctum no mesmo origin, usando o proxy Vite no desenvolvimento.
# Na Cloudflare Pages, defina antes do build: https://api.empresa.com.br/api
# A SPA e a API devem usar subdomínios do mesmo domínio para os cookies do Sanctum.
VITE_API_URL=

# Vite local: API acessível pela porta publicada do Nginx.
# No Docker Compose, VITE_BACKEND_URL é definido como http://nginx.
VITE_BACKEND_URL=http://localhost:8080

# Ative para detectar alterações em volumes Docker no Windows/WSL.
VITE_USE_POLLING=false
