APP_NAME="Homologa Solar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
FRONTEND_URL=http://localhost:8080

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=homologa
DB_USERNAME=homologa
DB_PASSWORD=homologa

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost:5173,127.0.0.1:8080

CACHE_STORE=redis
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=homologa
AWS_SECRET_ACCESS_KEY=homologa-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=homologa-documents
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="nao-responda@homologa.local"
MAIL_FROM_NAME="${APP_NAME}"

# Segredos — nunca persistidos no banco. O banco guarda apenas a referência (secret_ref).
SECRETS_DRIVER=env
CELESC_CREDENTIAL_PRODUCTION=
CELESC_CREDENTIAL_SANDBOX=

# Metas técnicas de engenharia (NÃO são SLA contratual) — a validar pelo negócio.
TARGET_AVAILABILITY_PERCENT=99.5
TARGET_P95_MS=2000
TARGET_RPO_HOURS=24
TARGET_RTO_HOURS=8
