APP_NAME="Homologa Solar"
APP_ENV=production
APP_DEBUG=false
# prepare-production.sh gera a chave no primeiro provisionamento. Em migrações, preserve a existente.
APP_KEY=
APP_URL=https://api.empresa.com.br
FRONTEND_URL=https://app.empresa.com.br
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

BCRYPT_ROUNDS=12
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Host/usuário/banco e senhas são fornecidos pelo Compose e pelos arquivos secrets/.
DB_CONNECTION=pgsql
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=.empresa.com.br
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=app.empresa.com.br
CACHE_STORE=redis
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
REDIS_QUEUE_RETRY_AFTER=90

FILESYSTEM_DISK=local

# Substitua pelo provedor SMTP real antes de liberar recuperação de senha.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.empresa.com.br
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=nao-responda@empresa.com.br
MAIL_FROM_NAME="${APP_NAME}"

SECRETS_DRIVER=env
CELESC_CREDENTIAL_PRODUCTION=
CELESC_CREDENTIAL_SANDBOX=
TARGET_AVAILABILITY_PERCENT=99.5
TARGET_P95_MS=2000
TARGET_RPO_HOURS=24
TARGET_RTO_HOURS=8
